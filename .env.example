# Copy to .env.local and fill in to switch the cloud on for a build.
# Both values are PUBLIC by design (Supabase's publishable/anon key is
# meant to ship in the app; row level security protects the data).
# Leave them empty and the app runs exactly as before: no sign-in,
# no sync. Secrets (service role key, Anthropic key, Paddle webhook
# secret) never go in this file — they live in Supabase function
# secrets. See docs/CLOUD.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
